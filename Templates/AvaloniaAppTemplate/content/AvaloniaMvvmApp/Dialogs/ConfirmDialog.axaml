<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="AvaloniaMvvmApp.Dialogs.ConfirmDialog">
	<Grid Margin="20"
		  MinWidth="260"
		  MaxWidth="520"
		  RowDefinitions="Auto,Auto"
		  ColumnDefinitions="*,*">

		<TextBlock x:Name="MessageTextBlock"
				   Grid.Row="0"
				   Grid.Column="0"
				   Grid.ColumnSpan="2"
				   Margin="0 0 0 20"
				   TextWrapping="Wrap"
				   TextAlignment="Center"
				   Foreground="{DynamicResource Theme_ForegroundMainBrush}"
				   FontSize="{StaticResource FontSizeLarge}"
				   FontWeight="Bold" />

		<!-- Кнопки-иконки Font Awesome: шаблон стиля IconGrowButton
		     подставляет иконку из Content. -->
		<Button x:Name="NoButton"
				Grid.Row="1"
				Grid.Column="0"
				Classes="IconGrowButton"
				Content="{StaticResource FA_CloseIcon}"
				Foreground="{StaticResource WordRedBrush}"
				FontSize="{StaticResource FontSizeXXLarge}"
				Width="50"
				Margin="5"
				HorizontalAlignment="Center" />

		<Button x:Name="YesButton"
				Grid.Row="1"
				Grid.Column="1"
				Classes="IconGrowButton"
				Content="{StaticResource FA_CheckIcon}"
				Foreground="{StaticResource WordGreenBrush}"
				FontSize="{StaticResource FontSizeXXLarge}"
				Width="50"
				Margin="5"
				HorizontalAlignment="Center" />
	</Grid>
</UserControl>
