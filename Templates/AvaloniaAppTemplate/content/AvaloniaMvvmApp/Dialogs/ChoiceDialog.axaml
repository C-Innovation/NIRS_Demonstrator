<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="220"
             x:Class="AvaloniaMvvmApp.Dialogs.ChoiceDialog">
	<Grid Margin="20"
		  MinWidth="300"
		  MaxWidth="560"
		  RowDefinitions="Auto,Auto">

		<TextBlock x:Name="MessageTextBlock"
				   Grid.Row="0"
				   Margin="0 0 0 20"
				   TextWrapping="Wrap"
				   TextAlignment="Center"
				   Foreground="{DynamicResource Theme_ForegroundMainBrush}"
				   FontSize="{StaticResource FontSizeLarge}" />

		<!-- Нейтральная кнопка скрывается, если её текст не задан:
		     один и тот же диалог служит и для двух, и для трёх вариантов. -->
		<StackPanel Grid.Row="1"
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					Spacing="10">

			<Button x:Name="NegativeButton"
					Classes="Regular"
					MinWidth="110" />

			<Button x:Name="NeutralButton"
					Classes="Regular"
					MinWidth="110"
					IsVisible="False" />

			<Button x:Name="PositiveButton"
					Classes="Regular"
					MinWidth="110" />
		</StackPanel>
	</Grid>
</UserControl>
