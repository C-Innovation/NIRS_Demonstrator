<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AvaloniaMvvmApp.Views"
        xmlns:vm="clr-namespace:AvaloniaMvvmApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="AvaloniaMvvmApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="600"
        MinWidth="480"
        MinHeight="320"
        Background="{DynamicResource Theme_BackgroundMainBrush}"
        Title="AvaloniaMvvmApp">
	<views:MainView />
</Window>
