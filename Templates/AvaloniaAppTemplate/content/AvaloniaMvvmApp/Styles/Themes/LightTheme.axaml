<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		Светлая тема.
		Обе темы обязаны объявлять один и тот же набор ключей Theme_*,
		иначе после переключения привязка {DynamicResource} не найдёт ресурс.
	-->

	<Color x:Key="Theme_BackgroundMain">#ffffff</Color>
	<SolidColorBrush x:Key="Theme_BackgroundMainBrush" Color="{StaticResource Theme_BackgroundMain}" />

	<Color x:Key="Theme_BackgroundSecondary">#efefef</Color>
	<SolidColorBrush x:Key="Theme_BackgroundSecondaryBrush" Color="{StaticResource Theme_BackgroundSecondary}" />

	<Color x:Key="Theme_ForegroundMain">#686868</Color>
	<SolidColorBrush x:Key="Theme_ForegroundMainBrush" Color="{StaticResource Theme_ForegroundMain}" />

	<Color x:Key="Theme_ForegroundSecondary">#9a9a9a</Color>
	<SolidColorBrush x:Key="Theme_ForegroundSecondaryBrush" Color="{StaticResource Theme_ForegroundSecondary}" />

	<Color x:Key="Theme_TitleBackground">#efefef</Color>
	<SolidColorBrush x:Key="Theme_TitleBackgroundBrush" Color="{StaticResource Theme_TitleBackground}" />

	<Color x:Key="Theme_Border">#bdbdbd</Color>
	<SolidColorBrush x:Key="Theme_BorderBrush" Color="{StaticResource Theme_Border}" />

	<Color x:Key="Theme_Accent">#0c6991</Color>
	<SolidColorBrush x:Key="Theme_AccentBrush" Color="{StaticResource Theme_Accent}" />
</ResourceDictionary>
