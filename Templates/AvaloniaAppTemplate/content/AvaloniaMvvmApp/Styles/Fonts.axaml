<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

	<!-- Размеры шрифта: единая шкала вместо чисел по месту использования -->
	<system:Double x:Key="FontSizeSmaller">10</system:Double>
	<system:Double x:Key="FontSizeSmall">12</system:Double>
	<system:Double x:Key="FontSizeRegular">14</system:Double>
	<system:Double x:Key="FontSizeAverage">18</system:Double>
	<system:Double x:Key="FontSizeLarge">20</system:Double>
	<system:Double x:Key="FontSizeXLarge">24</system:Double>
	<system:Double x:Key="FontSizeXXLarge">30</system:Double>
	<system:Double x:Key="FontSizeXXXLarge">48</system:Double>
	<system:Double x:Key="FontSizeXXXXLarge">72</system:Double>

	<!--
		Иконки Font Awesome.
		Значение — строка в формате Optris.Icons.Avalonia; подставляется
		в Content кнопки со стилем IconButton/IconGrowButton либо прямо в <i:Icon Value="..." />.
		Полный каталог имён: https://fontawesome.com/search?o=r&m=free
	-->

	<!-- Действия -->
	<system:String x:Key="FA_CheckIcon">fa-solid fa-check</system:String>
	<system:String x:Key="FA_CloseIcon">fa-solid fa-xmark</system:String>
	<system:String x:Key="FA_PlusIcon">fa-solid fa-plus</system:String>
	<system:String x:Key="FA_MinusIcon">fa-solid fa-minus</system:String>
	<system:String x:Key="FA_TrashIcon">fa-solid fa-trash</system:String>
	<system:String x:Key="FA_PenIcon">fa-solid fa-pen</system:String>
	<system:String x:Key="FA_SaveIcon">fa-regular fa-floppy-disk</system:String>
	<system:String x:Key="FA_RefreshIcon">fa-solid fa-arrows-rotate</system:String>
	<system:String x:Key="FA_SearchIcon">fa-solid fa-magnifying-glass</system:String>
	<system:String x:Key="FA_PlayIcon">fa-solid fa-play</system:String>
	<system:String x:Key="FA_PauseIcon">fa-solid fa-pause</system:String>
	<system:String x:Key="FA_StopIcon">fa-solid fa-stop</system:String>

	<!-- Навигация -->
	<system:String x:Key="FA_LeftLongIcon">fa-solid fa-left-long</system:String>
	<system:String x:Key="FA_RightLongIcon">fa-solid fa-right-long</system:String>
	<system:String x:Key="FA_AngleLeftIcon">fa-solid fa-angle-left</system:String>
	<system:String x:Key="FA_AngleRightIcon">fa-solid fa-angle-right</system:String>
	<system:String x:Key="FA_AngleUpIcon">fa-solid fa-angle-up</system:String>
	<system:String x:Key="FA_AngleDownIcon">fa-solid fa-angle-down</system:String>
	<system:String x:Key="FA_HouseIcon">fa-solid fa-house</system:String>
	<system:String x:Key="FA_BarsIcon">fa-solid fa-bars</system:String>

	<!-- Состояние и переключатели -->
	<system:String x:Key="FA_SquareIcon">fa-regular fa-square</system:String>
	<system:String x:Key="FA_SquareCheckIcon">fa-regular fa-square-check</system:String>
	<system:String x:Key="FA_CircleIcon">fa-solid fa-circle</system:String>
	<system:String x:Key="FA_EyeIcon">fa-solid fa-eye</system:String>
	<system:String x:Key="FA_EyeSlashIcon">fa-solid fa-eye-slash</system:String>
	<system:String x:Key="FA_CircleInfoIcon">fa-solid fa-circle-info</system:String>
	<system:String x:Key="FA_TriangleWarningIcon">fa-solid fa-triangle-exclamation</system:String>

	<!-- Разделы приложения -->
	<system:String x:Key="FA_GearIcon">fa-solid fa-gear</system:String>
	<system:String x:Key="FA_LanguageIcon">fa-solid fa-language</system:String>
	<system:String x:Key="FA_PaletteIcon">fa-solid fa-palette</system:String>
	<system:String x:Key="FA_FolderOpenIcon">fa-solid fa-folder-open</system:String>
	<system:String x:Key="FA_FileIcon">fa-solid fa-file</system:String>
	<system:String x:Key="FA_ChartIcon">fa-solid fa-chart-line</system:String>
</ResourceDictionary>
