<local:BasePage x:TypeArguments="vm:ChartsPageViewModel" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:NIRS_Demonstrator"
		 	 xmlns:vm="clr-namespace:NIRS_Demonstrator.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NIRS_Demonstrator.ChartsPage"
             x:DataType="vm:ChartsPageViewModel">
  <Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<!-- Header and back -->
			<RowDefinition Height="Auto" />
			<!-- Page content -->
			<RowDefinition Height="*" />

			<!-- Other (reserved) -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0"
			  Grid.Column="0"
			  Grid.ColumnSpan="2" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Button x:Name="BackToMainButton"
					Classes="IconGrowButton"
					Grid.Column="0"
					Content="{StaticResource FA_LeftLongIcon}"
					Margin="10 5 0 5"
					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource BackText}"
					Command="{Binding ReturnToMainCommand}"/>

			<!--Command="{Binding ShowHideGroupListCommand}"/>-->

			<!-- Header -->
			<TextBlock Grid.Row="0"
					   Grid.Column="0"
					   Grid.ColumnSpan="3"
					   Margin="0 30 0 0"
					   FontFamily="{StaticResource LatoBold}"
					   Foreground="{DynamicResource Theme_ForegroudMainBrush}"
					   Background="Transparent"
					   FontSize="{StaticResource FontSizeXXLarge}"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   Text="{DynamicResource ChartsText}"
					   FontWeight="Bold"/>




		</Grid>

		<!--<local:SettingsElement Grid.Row="1" Icon="Images/usa.png">-->
		<ScrollViewer VerticalScrollBarVisibility="Auto"
					  Grid.Column="0"
					  Grid.Row="1"
					  Grid.ColumnSpan="1">
			<Grid >
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
					<!-- <RowDefinition Height="*" /> -->
					<!-- <RowDefinition Height="*" /> -->
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				
				<local:Chart2D x:Name="Nirs1Chart740"
							   Grid.Row="0" 
							   ChartBackground="Transparent" 
							   BorderThickness="3"
							   BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
							   CornerRadius="7"
							   Margin="5">
					<local:Chart2D.ChartSeries>
						<local:Series Name="Nirs1Series740_1" Stroke="Red" StrokeThickness="2" />
						<local:Series Name="Nirs1Series740_2" Stroke="Green" StrokeThickness="2" />
						<local:Series Name="Nirs1Series740_3" Stroke="Blue" StrokeThickness="2" />
						<local:Series Name="Nirs1Series740_4" Stroke="Magenta" StrokeThickness="2" />
						<local:Series Name="Nirs1Series740_TotalVal" Stroke="Orange" StrokeThickness="2" />
						<local:Series Name="Nirs1Series740_AiVal" Stroke="Black" StrokeThickness="2" />
					</local:Chart2D.ChartSeries>
				</local:Chart2D>
				<local:Chart2D x:Name="Nirs1Chart850"
							   Grid.Row="1" 
							   ChartBackground="Transparent" 
							   BorderThickness="3"
							   BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
							   CornerRadius="7"
							   Margin="5">
					<local:Chart2D.ChartSeries>
						<local:Series Name="Nirs1Series850_1" Stroke="Red" StrokeThickness="2" />
						<local:Series Name="Nirs1Series850_2" Stroke="Green" StrokeThickness="2" />
						<local:Series Name="Nirs1Series850_3" Stroke="Blue" StrokeThickness="2" />
						<local:Series Name="Nirs1Series850_4" Stroke="Magenta" StrokeThickness="2" />
						<local:Series Name="Nirs1Series850_TotalVal" Stroke="Orange" StrokeThickness="2" />
						<local:Series Name="Nirs1Series850_AiVal" Stroke="Black" StrokeThickness="2" />
					</local:Chart2D.ChartSeries>
				</local:Chart2D>

				<!-- Text values -->
				<Grid Grid.Row="1"
					  HorizontalAlignment="Left"
					  VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock x:Name="Nirs1ValueText850_1"
							   Grid.Row="0"
							   Foreground="Red"
							   FontWeight="Bold"
							   FontSize="{StaticResource FontSizeLarge}"
							   Margin="10 0 0 0" />
					<TextBlock x:Name="Nirs1ValueText850_2"
							   Grid.Row="1"
							   HorizontalAlignment="Left"
							   VerticalAlignment="Center"
							   Foreground="Green"
							   FontWeight="Bold"
							   FontSize="{StaticResource FontSizeLarge}"
							   Margin="10 0 0 0" />
					<TextBlock x:Name="Nirs1ValueText850_3"
							   Grid.Row="2"
							   Foreground="Blue"
							   FontWeight="Bold"
							   FontSize="{StaticResource FontSizeLarge}"
							   Margin="10 0 0 0"
							   Text="{Binding Value850Ch3Text}" />
					<TextBlock x:Name="Nirs1ValueText850_4"
							   Grid.Row="3"
							   HorizontalAlignment="Left"
							   VerticalAlignment="Center"
							   Foreground="Magenta"
							   FontWeight="Bold"
							   FontSize="{StaticResource FontSizeLarge}"
							   Margin="10 0 0 0"
							   Text="{Binding Value850Ch4Text}" />
				</Grid>
				
				<!--
				<local:Chart2D x:Name="Nirs2Chart740"
							   Grid.Row="2" 
							   ChartBackground="Transparent" 
							   BorderThickness="3"
							   BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
							   CornerRadius="7"
							   Margin="5">
					<local:Chart2D.ChartSeries>
						<local:Series Name="Nirs2Series740_1" Stroke="Red" StrokeThickness="2" />
						<local:Series Name="Nirs2Series740_2" Stroke="Green" StrokeThickness="2" />
						<local:Series Name="Nirs2Series740_3" Stroke="Blue" StrokeThickness="2" />
						<local:Series Name="Nirs2Series740_4" Stroke="Magenta" StrokeThickness="2" />
					</local:Chart2D.ChartSeries>
				</local:Chart2D>
				<local:Chart2D x:Name="Nirs2Chart850"
							   Grid.Row="3" 
							   ChartBackground="Transparent" 
							   BorderThickness="3"
							   BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
							   CornerRadius="7"
							   Margin="5">
					<local:Chart2D.ChartSeries>
						<local:Series Name="Nirs2Series850_1" Stroke="Red" StrokeThickness="2" />
						<local:Series Name="Nirs2Series850_2" Stroke="Green" StrokeThickness="2" />
						<local:Series Name="Nirs2Series850_3" Stroke="Blue" StrokeThickness="2" />
						<local:Series Name="Nirs2Series850_4" Stroke="Magenta" StrokeThickness="2" />
					</local:Chart2D.ChartSeries>
					
				</local:Chart2D>
				-->
			</Grid>
		</ScrollViewer>
		<Grid x:Name="ComPortControlGrid"
			  Grid.Column="1"
			  Grid.Row="1"
			  HorizontalAlignment="Center"
			  Margin="0 5 5 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- NIRS COM port selector 1 -->
			<ComboBox x:Name="NirsComPortSelector1"
					  Grid.Row="0"
					  Grid.Column="0"
					  Grid.ColumnSpan="3"
					  BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
					  BorderThickness="2"
					  Foreground="{DynamicResource Theme_ForegroudMainBrush}"
					  FontSize="{StaticResource FontSizeLarge}"
					  FontWeight="Bold"
					  Width="{Binding #ComPortControlGrid.Bounds.Width}"
					  ItemsSource="{Binding AvailablePorts}"
					  SelectedItem="{Binding SelectedNirsPort1}"/>

			<!-- NIRS COM port selector 2 -->

			<ComboBox x:Name="NirsComPortSelector2"
					  Grid.Row="1"
					  Grid.Column="0"
					  Grid.ColumnSpan="3"
					  BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
					  BorderThickness="2"
					  Foreground="{DynamicResource Theme_ForegroudMainBrush}"
					  FontSize="{StaticResource FontSizeLarge}"
					  FontWeight="Bold"
					  Width="{Binding #ComPortControlGrid.Bounds.Width}"
					  ItemsSource="{Binding AvailablePorts}"
					  SelectedItem="{Binding SelectedNirsPort2}"
					  IsVisible="False"/>

			<ComboBox x:Name="HardwareAiDeviceSelector"
					  Grid.Row="2"
					  Grid.Column="0"
					  Grid.ColumnSpan="3"
					  BorderBrush="{DynamicResource Theme_ForegroudMainBrush}"
					  BorderThickness="2"
					  Foreground="{DynamicResource Theme_ForegroudMainBrush}"
					  FontSize="{StaticResource FontSizeLarge}"
					  FontWeight="Bold"
					  Width="{Binding #ComPortControlGrid.Bounds.Width}"
					  ItemsSource="{Binding AvailablePorts}"
					  SelectedItem="{Binding SelectedAiDevicePort}"
					  IsVisible="False"/>

			<!-- NIRS COM ports control -->
			<Button x:Name="StartComPortsButton"
					Classes="IconGrowButton"
					Grid.Row="3"
					Grid.Column="0"
					Content="{StaticResource FA_PlayIcon}"
					Foreground="{StaticResource WordGreenBrush}"
					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource NirsStartText}"
					Command="{Binding StartCommand}"/>
			<Button x:Name="RefreshComPortsButton"
					Classes="IconGrowButton"
					Grid.Row="3"
					Grid.Column="1"
					Content="{StaticResource FA_ArrowsRotate}"

					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource NirsUpdatePortsText}"
					Command="{Binding RefreshPortsCommand}"/>

			<Button x:Name="StopComPortsButton"
					Classes="IconGrowButton"
					Grid.Row="3"
					Grid.Column="2"
					Content="{StaticResource FA_StopIcon}"
					Foreground="{StaticResource WordRedBrush}"
					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource NirsStopText}"
					Command="{Binding StopCommand}"/>

			<!-- Мигание во время записи задаётся анимацией стиля, а не
			     фоновым потоком, дёргающим Opacity через диспетчер. -->
			<Button x:Name="StartRecordButton"
					Classes="IconGrowButton"
					Classes.recording="{Binding IsRecording}"
					Grid.Row="4"
					Grid.Column="0"
					Content="{StaticResource FA_CircleIcon}"
					Foreground="{StaticResource WordRedBrush}"
					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource StartRecordText}"
					Command="{Binding ToggleRecordCommand}">
				<Button.Styles>
					<Style Selector="Button.recording">
						<Style.Animations>
							<Animation Duration="0:0:0.5"
									   IterationCount="INFINITE"
									   PlaybackDirection="Alternate">
								<KeyFrame Cue="0%">
									<Setter Property="Opacity" Value="1.0"/>
								</KeyFrame>
								<KeyFrame Cue="100%">
									<Setter Property="Opacity" Value="0.0"/>
								</KeyFrame>
							</Animation>
						</Style.Animations>
					</Style>
				</Button.Styles>
			</Button>

			<Button x:Name="SettingsButton"
					Classes="IconGrowButton"
					Grid.Row="4"
					Grid.Column="2"
					Content="{StaticResource FA_GearIcon}"
					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource SettingsText}"
					Command="{Binding OpenSettingsCommand}"/>

			<!-- Channel 1 configuration -->
			<NumericUpDown x:Name="LedsIrCurrentCongig"
						   Grid.Column="0"
						   Grid.ColumnSpan="3"
						   Grid.Row="5"
						   Minimum="0"
						   Maximum="100"
						   Increment="0.20"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   Foreground="{DynamicResource Theme_ForegroudMainBrush}"
						   Background="Transparent"
						   FontSize="{StaticResource FontSizeLarge}"
						   Width="{Binding #ComPortControlGrid.Bounds.Width}"
						   Value="{Binding LedCurrentPercent}"/>

			<!-- Filters control -->
			<Button x:Name="ResetFiltersButton"
					Classes="IconGrowButton"
					Grid.Row="6"
					Grid.Column="0"
					Content="{StaticResource FA_ArrowsRotate}"

					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource NirsUpdatePortsText}"
					Command="{Binding ResetFiltersCommand}"/>

						<!-- Filters control -->
			<Button x:Name="GenBuildDatasetCmdButton"
					Classes="IconGrowButton"
					Grid.Row="6"
					Grid.Column="3"
					Content="{StaticResource FA_ArrowDown}"

					FontSize="{StaticResource FontSizeXXLarge}"
					ToolTip.Tip="{DynamicResource NirsUpdatePortsText}"
					Command="{Binding GenBuildDatasetCmdCommand}"/>

			<!-- Human ID for dataset -->
			<TextBox x:Name="HumanIdText"
					 Grid.Row="7"
					 Grid.Column="0"
					 Grid.ColumnSpan="3"
					 Foreground="{DynamicResource Theme_ForegroudMainBrush}"
					 Background="Transparent"
					 Margin="0 5 0 5"
					 FontSize="{StaticResource FontSizeLarge}"
					 Text="{Binding HumanIdText, Mode=TwoWay}"/>

			<!-- Placement ID for dataset -->
			<NumericUpDown x:Name="PlacementIdNum"
						   Grid.Column="0"
						   Grid.ColumnSpan="3"
						   Grid.Row="8"
						   Minimum="0"
						   Maximum="1000"
						   Increment="1"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   Foreground="{DynamicResource Theme_ForegroudMainBrush}"
						   Background="Transparent"
						   FontSize="{StaticResource FontSizeLarge}"
						   Width="{Binding #ComPortControlGrid.Bounds.Width}"
						   Value="{Binding PlacementIdNum, Mode=TwoWay}"/>
		</Grid>
				
	</Grid>
</local:BasePage>
